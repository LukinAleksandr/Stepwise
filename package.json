{
  "name": "stepwise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "biome format --write",
    "check": "biome check && tsc -b && npm run check:boundaries && npm run check:content",
    "check:fix": "biome check --write",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@tabler/icons-react": "^3.48.0",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
